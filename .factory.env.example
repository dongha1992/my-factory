OWNER=your-github-id
PROJECT=1            # GitHub Project 번호
# Status 컬럼 이름 (새 Project의 기본 컬럼과 같다)
READY=Todo
BUILDING="In Progress"
DONE=Done
QA=QA
AI_REVIEW="AI Review"
REWORK=Rework
MAX_REWORK=2          # AI 리뷰 반려 허용 횟수
# TEST_CMD="npm test" # (선택) QA 워커 전에 PR 브랜치에서 실행. 실패하면 토큰 없이 Rework(MAX_REWORK 초과 시 Blocked)
REVIEW=Review
BLOCKED=Blocked
